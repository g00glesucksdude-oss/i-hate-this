-- 🚦 Validation Logic
button.MouseButton1Click:Connect(function()
    local raw = input.Text:match("^%s*(.-)%s*$")
    local hash, expiry = raw:match("^(%x+)|(%d+)$")
    if not hash or not expiry then
        status.Text = "❌ Format must be: hash|expiry"
        return
    end

    expiry = tonumber(expiry)
    if not expiry then
        status.Text = "❌ Invalid expiry"
        return
    end

    if os.time() > expiry then
        status.Text = "⏳ Key expired"
        return
    end

    if isUsed(hash) then
        status.Text = "🚫 Hash already used"
        return
    end

    markUsed(hash)
    status.Text = "✅ Hash accepted"

    spawn(function()
        while os.time() <= expiry do wait(1) end
        print("🛑 Hash expired. Loader halted.")
    end)

    local script = game:HttpGet("https://pastebin.com/raw/GTVsPG5x", true)
    local injected = string.format("local expiry = %d\n%s", expiry, script)
    loadstring(injected)()
end)
