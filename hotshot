local raw = "R0dMLXNhbmRib3gtMTIzNDU2Nzg5MC1hYmMtMTIz"
local function dumpBytes(data)
    for i = 1, #data do
        local b = data:sub(i, i):byte()
        print(string.format("Byte %d = %d", i, b))
    end
end

local function b64decode(data)
    local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    local b64lookup = {}
    for i = 1, #b64chars do
        b64lookup[b64chars:sub(i, i)] = i - 1
    end

    data = data:gsub('[^'..b64chars..'=]', '')
    local result = {}
    local buffer, bits = 0, 0

    for i = 1, #data do
        local c = data:sub(i, i)
        if c ~= '=' then
            buffer = buffer * 64 + b64lookup[c]
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local byte = math.floor(buffer / 2^bits) % 256
                result[#result + 1] = string.char(byte)
                buffer = buffer % 2^bits
            end
        end
    end

    return table.concat(result)
end

local decoded = b64decode(raw)
dumpBytes(decoded)
