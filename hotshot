-- 🚦 Decode Logic
decodeButton.MouseButton1Click:Connect(function()
    local rawInput = input.Text:match("^%s*(.-)%s*$")
    local success, decoded, err = pcall(decodeBase64, rawInput)

    if not success or err or not decoded then
        debugLabel.Text = "❌ " .. (err or "Unknown decode failure")
        outputLabel.Text = "—"
        warn("Decode error:", err)
    else
        debugLabel.Text = "✅ Decoded successfully"
        outputLabel.Text = escapeNonPrintable(decoded)
        print("🔓 Decoded:", decoded)
    end
end)

