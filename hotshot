-- 🔐 Used Hash Tracker
local usedFile = "used_hashes.txt"
local function loadUsed()
    local hashes = {}
    if isfile(usedFile) then
        for line in string.gmatch(readfile(usedFile), "[^\r\n]+") do
            hashes[line] = true
        end
    end
    return hashes
end
local function isUsed(h) return loadUsed()[h] end
local function markUsed(h) if not isUsed(h) then appendfile(usedFile, h .. "\n") end end

-- 🔐 SHA-256 Implementation (pure Lua)
local bit = bit32
local function rrotate(x, n) return bit.rrotate(x, n) end
local function sha256(msg)
    local K = {
        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66f,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
    }

    local function preprocess(msg)
        local len = #msg * 8
        msg = msg .. "\128"
        while (#msg * 8) % 512 ~= 448 do msg = msg .. "\0" end
        for i = 56, 63 do msg = msg .. string.char((len >> ((63 - i) * 8)) & 0xff) end
        return msg
    end

    local function to_words(msg)
        local words = {}
        for i = 1, #msg, 4 do
            local b1, b2, b3, b4 = msg:byte(i, i+3)
            table.insert(words, bit.lshift(b1, 24) + bit.lshift(b2, 16) + bit.lshift(b3, 8) + b4)
        end
        return words
    end

    msg = preprocess(msg)
    local words = to_words(msg)
    local H = {
        0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
        0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19
    }

    for i = 1, #words, 16 do
        local W = {}
        for j = 0, 15 do W[j] = words[i + j] end
        for j = 16, 63 do
            local s0 = bit.bxor(rrotate(W[j-15], 7), rrotate(W[j-15], 18), bit.rshift(W[j-15], 3))
            local s1 = bit.bxor(rrotate(W[j-2], 17), rrotate(W[j-2], 19), bit.rshift(W[j-2], 10))
            W[j] = (W[j-16] + s0 + W[j-7] + s1) & 0xffffffff
        end

        local a,b,c,d,e,f,g,h = table.unpack(H)
        for j = 0, 63 do
            local S1 = bit.bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
            local ch = bit.bxor(bit.band(e, f), bit.band(bit.bnot(e), g))
            local temp1 = (h + S1 + ch + K[j+1] + W[j]) & 0xffffffff
            local S0 = bit.bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
            local maj = bit.bxor(bit.band(a, b), bit.band(a, c), bit.band(b, c))
            local temp2 = (S0 + maj) & 0xffffffff

            h = g
            g = f
            f = e
            e = (d + temp1) & 0xffffffff
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & 0xffffffff
        end

        H[1] = (H[1] + a) & 0xffffffff
        H[2] = (H[2] + b) & 0xffffffff
        H[3] = (H[3] + c) & 0xffffffff
        H[4] = (H[4] + d) & 0xffffffff
        H[5] = (H[5] + e) & 0xffffffff
        H[6] = (H[6] + f) & 0xffffffff
        H[7] = (H[7] + g) & 0xffffffff
        H[8] = (H[8] + h) & 0xffffffff
    end

    return string.format("%08x%08x%08x%08x%08x%08x%08x%08x", table.unpack(H))
end

