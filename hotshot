local function testByteIntegrity()
    local raw = "R0dMLXNhbmRib3gtMTIzNDU2Nzg5MC1hYmMtMTIz" -- GGL-sandbox-1234567890-abc-123
    local decoded = b64decode(raw)
    print("📥 Decoded:", decoded)
    for i = 1, #decoded do
        local byte = decoded:sub(i, i):byte()
        print(string.format("Byte %d = %d", i, byte))
    end
end

testByteIntegrity()
