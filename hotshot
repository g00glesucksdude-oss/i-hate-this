-- 🔓 Base64 Decoder Script (Roblox Lua)

local encoded = "R0dMLXNhbmRib3gtMTIzNC1zYWx0LTEyMw=="  -- Example base64 key
local decoded = nil

local success, result = pcall(function()
    return base64.decode(encoded)
end)

if success then
    decoded = result
    print("✅ Decoded key:", decoded)
else
    print("❌ Failed to decode. Input may not be valid base64.")
end
