-- 🧬 Base64 Decoder GUI (Executor-Only)
local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local b64lookup = {}
for i = 1, #b64chars do
    b64lookup[b64chars:sub(i, i)] = i - 1
end

local function isValidBase64(s)
    return s:match("^[A-Za-z0-9+/=]+$") ~= nil and (#s % 4 == 0)
end

local function decodeBase64(data)
    data = data:gsub("[^A-Za-z0-9+/=]", "")
    if not isValidBase64(data) then
        return nil, "Invalid Base64 format"
    end

    local bytes, buffer, bits = {}, 0, 0
    for i = 1, #data do
        local c = data:sub(i, i)
        if c ~= '=' then
            local val = b64lookup[c]
            if not val then
                return nil, "Invalid character: " .. c
            end
            buffer = buffer * 64 + val
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local byte = math.floor(buffer / 2^bits)
                buffer = buffer % 2^bits
                table.insert(bytes, string.char(byte))
            end
        end
    end
    return table.concat(bytes), nil
end

local function escapeNonPrintable(s)
    return s:gsub(".", function(c)
        local b = string.byte(c)
        return (b < 32 or b > 126) and string.format("\\x%02X", b) or c
    end)
end

